{
  "version": 1,
  "default_verdict": "review",
  "session": {
    "freeze_after_blocks": 3,
    "freeze_window_seconds": 3600
  },
  "detectors": {
    "disabled": [],
    "params": {}
  },
  "protected": {
    "paths": [
      "~/.antiai/**",
      "**/antiai-policy*.json",
      "**/antiai-policy*.yaml",
      "**/antiai-policy*.yml",
      "**/*.audit.jsonl"
    ],
    "processes": [
      "antiai",
      "antiai-guard"
    ]
  },
  "always_block_commands": [
    "rm\\s+-rf\\s+/(?:\\s|$)",
    ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\}\\s*;\\s*:",
    "mkfs\\.\\w+\\s+/dev/",
    "dd\\s+if=/dev/(?:zero|urandom)\\s+of=/dev/[a-z]+",
    ">\\s*/dev/sd[a-z]+\\b"
  ],
  "rules": [
    {
      "id": "allow-read-tools",
      "description": "常规只读操作放行（仍受检测器约束）",
      "match": {
        "tool": [
          "file.read",
          "file.list",
          "fs.read",
          "search.*",
          "read_*",
          "grep*",
          "cat_file"
        ]
      },
      "verdict": "allow",
      "severity": "low",
      "reason": "常规只读操作"
    },
    {
      "id": "block-secret-access",
      "description": "禁止读取或触碰密钥/凭据类资产",
      "match": {
        "path": [
          "**/.env",
          "**/.env.*",
          "**/.ssh/**",
          "**/id_rsa",
          "**/id_ed25519",
          "**/*.pem",
          "**/*.key",
          "**/.aws/**",
          "**/.git-credentials",
          "**/credentials*",
          "**/authorized_keys"
        ]
      },
      "verdict": "block",
      "severity": "high",
      "reason": "密钥/凭据类文件属于高敏感资产"
    },
    {
      "id": "block-guardrail-assets",
      "description": "护栏策略、审计与状态目录不可被被管对象读写",
      "match": {
        "path": [
          "~/.antiai/**",
          "**/antiai-policy*.json",
          "**/antiai-policy*.yaml",
          "**/antiai-policy*.yml",
          "**/*.audit.jsonl"
        ]
      },
      "verdict": "block",
      "severity": "critical",
      "reason": "护栏自身资产受保护，防止被篡改或销毁"
    },
    {
      "id": "review-network-egress",
      "description": "对外网络请求默认需人工确认（白名单见检测器参数 egress_allow）",
      "match": {
        "tool": [
          "http.*",
          "web.*",
          "net.*",
          "fetch*",
          "request*",
          "curl*",
          "download*",
          "upload*"
        ]
      },
      "verdict": "review",
      "severity": "medium",
      "reason": "对外网络访问默认需人工确认"
    },
    {
      "id": "review-shell-exec",
      "description": "Shell / 执行类工具默认需人工确认（可用更高 priority 的 allow 规则细化白名单）",
      "match": {
        "tool": [
          "shell.*",
          "bash*",
          "exec*",
          "terminal.*",
          "process.*",
          "system.*"
        ]
      },
      "verdict": "review",
      "severity": "medium",
      "reason": "执行类工具默认需人工确认"
    }
  ]
}
